# Copy to .env.local (or set in Vercel → Project → Settings → Environment Variables).
# Use TEST keys until you're ready to go live. Never commit real keys.

# Stripe secret key (test mode starts with sk_test_...)
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe webhook signing secret (whsec_...), once you add a webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase (Project Settings -> API). The SERVICE ROLE key is secret — server only.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # service_role, NOT the anon key
# The anon key is used by the browser client in Phase 2 (safe to expose):
# SUPABASE_ANON_KEY=eyJ...
